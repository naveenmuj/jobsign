{
  "expo": {
    "name": "JobSign: Contractor Quote & Sign",
    "slug": "jobsign",
    "scheme": "jobsign",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0B0F19",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jobsign.app",
      "infoPlist": {
        "NSCameraUsageDescription": "JobSign requires camera access to attach worksite damage proof photos to your contracts.",
        "NSPhotoLibraryUsageDescription": "JobSign accesses your photo library to attach worksite proof photos."
      }
    },
    "android": {
      "package": "com.jobsign.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "JobSign requires camera access to capture worksite pre-existing damage proof."
        }
      ],
      "expo-sqlite"
    ]
  }
}
